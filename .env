# 100% Free Cloudflare Universal SSL Subdomain Architecture (*.oxyjet.win)
MAIN_SITE_DOMAIN=beauty.oxyjet.win
BASE_API_URL=https://beauty-api.oxyjet.win
AGENT_REGISTRY_URL=https://beauty-registry.oxyjet.win/mcp
ADMIN_CMS_URL=https://beauty-admin.oxyjet.win
A2A_AGENTS_URL=https://beauty-agents.oxyjet.win

# Dedicated Google Cloud Project Credentials
# Command to set quota project in CLI: gcloud auth application-default set-quota-project beauty-care-platform
GOOGLE_CLOUD_PROJECT=beauty-care-platform
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# DIKIDI / CRM Credentials
DIKIDI_API_KEY=your_dikidi_partner_token
DIKIDI_PROJECT_ID=your_dikidi_salon_id

# Google Maps Platform (Places API New & Routes API enabled in beauty-care-platform)
GOOGLE_MAPS_API_KEY=

# Security & PII Encryption Key
PII_ENCRYPTION_KEY=

# Local Dev Ports
CONCIERGE_AGENT_PORT=8010
HAIR_CARE_AGENT_PORT=8011
COSMETOLOGY_AGENT_PORT=8012
NAIL_STYLE_AGENT_PORT=8013
NAVIGATION_AGENT_PORT=8014
BOOKING_CRM_AGENT_PORT=8015
